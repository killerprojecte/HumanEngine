# Required for the administration API. Set a long random value locally.
HUMANENGINE_ADMIN_TOKEN=
# Optional legacy fallback only. Prefer entering model API keys directly in the UI.
OPENAI_API_KEY=
HUMANENGINE_DB=data/humanengine.sqlite
HOST=127.0.0.1
PORT=3000

# Optional legacy fallback only. Prefer entering SnowLuma tokens directly in the UI.
SNOWLUMA_TOKEN=
# Optional comma-separated trusted .mjs entries relative to ./plugins.
HUMANENGINE_PLUGINS=
