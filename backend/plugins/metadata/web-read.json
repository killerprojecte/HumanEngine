{
  "id": "web-read",
  "name": "HTTP requests and webpage reader",
  "version": "0.2.0",
  "description": "Stream public HTTP(S) responses into a lossless temporary cache. Read text or binary ranges without refetching. Supports structured curl-like requests; private destinations and unsafe transport overrides stay blocked.",
  "capabilities": [
    "tool",
    "schema-form"
  ],
  "configSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "timeoutMs": {
        "default": 60000,
        "type": "integer",
        "minimum": 500,
        "maximum": 2147483647
      },
      "maxResponseBytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "maxChars": {
        "default": 4000,
        "type": "integer",
        "minimum": 256,
        "maximum": 30000
      },
      "maxConcurrency": {
        "default": 2,
        "type": "integer",
        "minimum": 1,
        "maximum": 64
      }
    },
    "additionalProperties": false
  },
  "apiVersion": 2
}
