+// Node ws normalizes extension values with Number(), then checks integer 8..15.
+func windowBits(raw string) (int, bool) {
+	var n float64
+	var err error
+	if len(raw) > 2 && raw[0] == '0' && strings.ContainsAny(raw[1:2], "xXbBoO") {
+		base := 16
+		switch raw[1] {
+		case 'b', 'B':
+			base = 2
+		case 'o', 'O':
+			base = 8
+		}
+		value, e := strconv.ParseUint(raw[2:], base, 64)
+		err = e
+		n = float64(value)
+	} else {
+		n, err = strconv.ParseFloat(raw, 64)
+	}
+	if err != nil || math.IsNaN(n) || math.IsInf(n, 0) || n < 8 || n > 15 || math.Trunc(n) != n {
+		return 0, false
+	}
+	return int(n), true
+}
