+// FinishProtocolClose completes a protocol-error close already written by Reader.
+// The owner can interrupt it with CloseNow during adapter disposal.
+func (c *Conn) FinishProtocolClose() bool {
+	code := c.protocolCloseCode.Load()
+	if !c.client || code == 0 {
+		return false
+	}
+	_ = c.Close(StatusCode(code), "")
+	return true
+}
