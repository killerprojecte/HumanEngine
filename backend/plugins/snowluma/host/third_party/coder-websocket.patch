+// A Huffman-only stream has no distance references and therefore satisfies
+// every negotiated DEFLATE window, without misrepresenting a 32KiB encoder.
+func getHuffmanWriter(w io.Writer) *flate.Writer {
+	fw, ok := huffmanWriterPool.Get().(*flate.Writer)
+	if !ok {
+		fw, _ = flate.NewWriter(w, flate.HuffmanOnly)
+		return fw
+	}
+	fw.Reset(w)
+	return fw
+}
+func putHuffmanWriter(w *flate.Writer) { huffmanWriterPool.Put(w) }
 
