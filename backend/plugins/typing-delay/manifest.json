{
  "id": "typing-delay",
  "name": "Typing delay",
  "version": "0.1.0",
  "description": "Optional human typing delay for each complete outgoing message segment, not each sentence.",
  "capabilities": [
    "send-delay",
    "schema-form"
  ],
  "configSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "speedFactor": {
        "default": 1,
        "type": "number",
        "minimum": 0.1,
        "maximum": 10
      }
    },
    "additionalProperties": false
  },
  "apiVersion": 2
}
