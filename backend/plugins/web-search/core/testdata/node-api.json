{
  "cases": [
    {
      "provider": "tavily",
      "body": "{\"results\":[{\"title\":\"Result\",\"url\":\"https://example.com\",\"content\":\"Source text\"}]}",
      "expected": [
        {
          "provider": "tavily",
          "title": "Result",
          "url": "https://example.com/",
          "snippet": "Source text"
        }
      ]
    },
    {
      "provider": "you",
      "body": "{\"results\":{\"web\":[{\"title\":\"Result\",\"url\":\"https://Example.com:443/a/../b\",\"snippets\":[\"one\",42,\"two\"]}]}}",
      "expected": [
        {
          "provider": "you",
          "title": "Result",
          "url": "https://example.com/b",
          "snippet": "one\ntwo"
        }
      ]
    },
    {
      "provider": "you_news",
      "body": "{\"results\":{\"web\":[]}}",
      "expected": []
    },
    {
      "provider": "deepseek",
      "body": "{\"results\":[{\"title\":\"你好\",\"url\":\"https://例子.com/中文\",\"snippet\":\"结果\"}]}",
      "expected": [
        {
          "provider": "deepseek",
          "title": "你好",
          "url": "https://xn--fsqu00a.com/%E4%B8%AD%E6%96%87",
          "snippet": "结果"
        }
      ]
    },
    {
      "provider": "tavily",
      "body": "{\"results\":[]}",
      "expected": []
    }
  ],
  "urls": [
    {
      "url": "https://EXAMPLE.com",
      "expected": "https://example.com/"
    },
    {
      "url": "http://example.com:80/path",
      "expected": "http://example.com/path"
    },
    {
      "url": "https://example.com:8443/",
      "expected": ""
    },
    {
      "url": "http://127.0.0.1",
      "expected": ""
    },
    {
      "url": "http://0177.0.0.1",
      "expected": ""
    },
    {
      "url": "https://a.internal",
      "expected": ""
    },
    {
      "url": "javascript:alert(1)",
      "expected": ""
    },
    {
      "url": "https://user:pass@example.com",
      "expected": ""
    },
    {
      "url": "https://例子.com/中文",
      "expected": "https://xn--fsqu00a.com/%E4%B8%AD%E6%96%87"
    },
    {
      "url": "https://example.com/a/../b",
      "expected": "https://example.com/b"
    }
  ]
}
