{
  "name": "humanengine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "contract": "node --import tsx scripts/contract.ts",
    "contract:check": "node --import tsx scripts/contract.ts --check",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.runtime.json && nuxt typecheck",
    "check": "npm run contract:check && npm test && npm run typecheck"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.14",
    "nuxt": "4.6.2",
    "openapi-fetch": "0.17.0",
    "sqlite-vec": "0.1.9",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44",
    "zod": "4.6.7",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13",
    "@iconify-json/lucide": "1.2.147",
    "@types/ws": "8.18.2"
  }
}
