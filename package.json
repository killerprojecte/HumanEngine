{
  "name": "humanengine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build && node scripts/build-recovery-cli.mjs",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "contract": "node --import tsx scripts/contract.ts",
    "contract:check": "node --import tsx scripts/contract.ts --check",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.runtime.json && nuxt typecheck",
    "check": "npm run contract:check && npm test && npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backup": "node --import tsx scripts/backup.ts",
    "restore": "node --import tsx scripts/restore.ts",
    "benchmark:vectors": "node --import tsx scripts/vector-benchmark.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "better-sqlite3": "13.0.3",
    "entities": "7.0.1",
    "hono": "4.13.14",
    "nuxt": "4.6.2",
    "openapi-fetch": "0.17.0",
    "sharp": "0.35.5",
    "sqlite-vec": "0.1.9",
    "tailwindcss": "4.3.3",
    "ultrahtml": "1.7.0",
    "vue": "3.5.44",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.147",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "fontless": {
      "esbuild": "0.28.2"
    }
  }
}
